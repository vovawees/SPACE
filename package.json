{
  "name": "space",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "SPACE — бесконечная доска: заметки, код, файлы, ссылки, умное рисование и совместная работа в реальном времени.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "node scripts/prepare.cjs deps",
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch-path=src/server --watch-path=src/shared src/server/index.ts",
    "prebuild": "node scripts/prepare.cjs deps",
    "build": "vite build && node scripts/precompress.ts && node scripts/prepare.cjs stamp",
    "prestart": "node scripts/prepare.cjs start",
    "start": "node --disable-warning=ExperimentalWarning src/server/index.ts",
    "service": "node scripts/prepare.cjs start && node --disable-warning=ExperimentalWarning scripts/service.ts install",
    "service:remove": "node --disable-warning=ExperimentalWarning scripts/service.ts remove",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "pretest": "node scripts/prepare.cjs deps",
    "test": "vitest run",
    "pree2e": "node scripts/prepare.cjs start",
    "e2e": "node tests/e2e/run.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/marck-script": "^5.3.0",
    "@fontsource/neucha": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/ruslan-display": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@hocuspocus/provider": "^4.7.1",
    "@hocuspocus/server": "^4.7.1",
    "@hono/node-server": "^2.1.5",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.61.0",
    "fflate": "^0.8.3",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.14",
    "htmlparser2": "^12.0.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "nanoid": "^6.0.2",
    "perfect-freehand": "^1.2.3",
    "uqr": "^0.1.3",
    "ws": "^8.22.0",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
