# Настройки SPACE. Скопируйте в .env и раскомментируйте нужное —
# без .env работают значения по умолчанию, указанные ниже.

# Порт и адрес. 0.0.0.0 — доступ из локальной сети и Tailscale,
# 127.0.0.1 — только с этого компьютера.
# PORT=8787
# HOST=0.0.0.0

# Где лежат база (space.db), файлы и превью досок.
# Относительный путь — от папки SPACE, ~/ — от домашней папки.
# STORAGE_DIR=./storage

# Максимальный размер одного загружаемого файла, МБ.
# MAX_UPLOAD_MB=512

# Код приглашения. Если задан — без него нельзя создать новый аккаунт
# (полезно, когда сервер открыт в интернет, например на Railway).
# SPACE_INVITE_CODE=

# Токен GitHub (без прав, только чтение публичного): больше запросов
# к API для карточек репозиториев, issues и файлов — 5000 в час вместо 60.
# Для приватных репозиториев — токен с доступом на чтение к ним.
# GITHUB_TOKEN=

# Разрешить превью ссылок на адреса локальной сети (192.168.*, 100.64.* и т.п.).
# По умолчанию запрещено — защита от SSRF.
# UNFURL_PRIVATE=0

# Сервер за обратным прокси (Railway, nginx, Caddy): доверять X-Forwarded-*.
# TRUST_PROXY=0
